    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const sourceChunk = $('Code in JavaScript2').all()[index];\n\n  return {\n    json: {\n      content: sourceChunk.json.content,\n      source: sourceChunk.json.source,\n      embedding: item.json.embedding\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
