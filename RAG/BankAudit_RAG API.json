      "parameters": {
        "jsCode": "const chunks = $input.all();\n\nreturn [\n  {\n    json: {\n      context: chunks\n        .map((item, index) => \n          `DOCUMENT CHUNK ${index + 1}:\\n${item.json.content}`\n        )\n        .join('\\n\\n')\n    }\n  }\n];"
      },
