    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text;\n\nconst chunkSize = 1000;\nconst overlap = 200;\n\nconst chunks = [];\n\nfor (let i = 0; i < text.length; i += chunkSize - overlap) {\n  const chunk = text.slice(i, i + chunkSize).trim();\n\n  if (chunk) {\n    chunks.push({\n      json: {\n        content: chunk,\n        source: \"BankAudit.pdf\"\n      }\n    });\n  }\n}\n\nreturn chunks;"
      },
